      "args": ["--no-log", "--no-trace"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "internalConsole",
    },
    {
      "name": "AngrySanta GPU",
      "type": "cppvsdbg", // MSVC Debugger
      "request": "launch",
      "program": "${workspaceFolder}\\build\\AngrySanta_GPU.exe",
      "args": ["--no-log", "--no-trace"],
      "stopAtEntry": false,
