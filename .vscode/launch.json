  "version": "0.2.0",
  "configurations": [
    {
      "name": "AngrySanta SISD",
      "type": "cppvsdbg", // MSVC Debugger
      "request": "launch",
      "program": "${workspaceFolder}\\build\\AngrySanta_SISD.exe",
      "args": ["--no-log", "--no-trace"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "internalConsole",
    },
    {
