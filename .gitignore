.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Build directories
build/
bin/
obj/
out/

# Backup files
*.bak
*.backup
*_backup

# Temporary files
*.tmp
*.temp

# CMake
CMakeCache.txt
CMakeFiles/
